{
  "firestore": {
    "rules": "firestore.rules",
    "database": "(default)"
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ]
  },
  "apphosting": {
    "backendId": "ludo-web-app",
    "rootDir": "/",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "functions"
    ],
    "alwaysDeployFromSource": true
  },
  "functions": [
    {
      "source": ".firebase/ludos-website/functions",
      "codebase": "firebase-frameworks-ludos-website"
    }
  ]
}
