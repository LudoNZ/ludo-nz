{
  "firestore": {
    "rules": "firestore.rules",
    "database": "(default)"
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ]
  },
  "apphosting": {
    "backendId": "ludo-web-app",
    "rootDir": "/",
    "ignore": [
      "node_modules",
      ".git",
      ".firebase",
      ".next",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "functions"
    ],
    "alwaysDeployFromSource": true
  }
}
