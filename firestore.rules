rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ContactUs collection - only server-side writes via API route
    // Client-side access is restricted for security
    match /ContactUs/{document} {
      // Deny all client-side reads and writes
      // Only server-side (admin SDK) can access this collection
      allow read: if false;
      allow write: if false;
    }
    
    // Allow authenticated admin users to read ContactUs (optional)
    // Uncomment and adjust if you want admin dashboard access
    // match /ContactUs/{document} {
    //   allow read: if request.auth != null && 
    //                  request.auth.token.admin == true;
    //   allow write: if false;
    // }
    
    // Dice Roll Tracker sessions
    match /diceSessions/{sessionId} {
      allow get: if true;
      allow list: if request.auth != null && request.auth.token.admin == true;
      allow create: if request.resource.data.keys().hasAll(['createdAt', 'creatorName', 'players', 'customRules'])
        && request.resource.data.creatorName is string
        && request.resource.data.players is list
        && request.resource.data.customRules is list;
      allow update: if request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.creatorName == resource.data.creatorName;
      allow delete: if false;

      match /rolls/{rollId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasAll(['player', 'die1', 'die2', 'total', 'isRandom', 'game', 'timestamp'])
          && request.resource.data.die1 is int
          && request.resource.data.die2 is int
          && request.resource.data.die1 >= 1 && request.resource.data.die1 <= 6
          && request.resource.data.die2 >= 1 && request.resource.data.die2 <= 6
          && request.resource.data.total == request.resource.data.die1 + request.resource.data.die2
          && request.resource.data.game is int;
        allow update, delete: if false;
      }
    }

    // Default: deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
