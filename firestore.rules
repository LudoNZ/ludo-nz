rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ContactUs collection - only server-side writes via API route
    // Client-side access is restricted for security
    match /ContactUs/{document} {
      // Deny all client-side reads and writes
      // Only server-side (admin SDK) can access this collection
      allow read: if false;
      allow write: if false;
    }
    
    // Allow authenticated admin users to read ContactUs (optional)
    // Uncomment and adjust if you want admin dashboard access
    // match /ContactUs/{document} {
    //   allow read: if request.auth != null && 
    //                  request.auth.token.admin == true;
    //   allow write: if false;
    // }
    
    // Dice Roll Tracker sessions
    match /diceSessions/{sessionId} {
      allow get: if true;
      allow list: if request.auth != null && request.auth.token.admin == true;
      allow create: if request.resource.data.keys().hasAll(['createdAt', 'creatorName', 'players', 'customRules'])
        && request.resource.data.creatorName is string
        && request.resource.data.players is list
        && request.resource.data.customRules is list;
      allow update: if request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.creatorName == resource.data.creatorName;
      allow delete: if false;

      match /rolls/{rollId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasAll(['player', 'dice', 'diceTypes', 'total', 'isRandom', 'game', 'timestamp'])
          && request.resource.data.dice is list
          && request.resource.data.dice.size() >= 1
          && request.resource.data.dice.size() <= 6
          && request.resource.data.diceTypes is list
          && request.resource.data.total is int
          && request.resource.data.game is int;
        allow update: if false;
        allow delete: if true;
      }
    }

    // Menu sessions
    match /menuSessions/{sessionId} {
      allow get: if true;
      allow list: if false;
      allow create: if request.resource.data.keys().hasAll(['createdAt', 'creatorName'])
        && request.resource.data.creatorName is string;
      allow update: if true;
      allow delete: if false;

      match /pantry/{itemId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasAll(['name', 'quantity', 'updatedAt'])
          && request.resource.data.name is string;
        allow update: if true;
        allow delete: if true;
      }

      match /consumptionLog/{logId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasAll(['mealId', 'mealName', 'date'])
          && request.resource.data.mealName is string;
        allow update: if false;
        allow delete: if true;
      }

      match /meals/{mealId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasAll(['name', 'ingredients', 'steps', 'createdAt'])
          && request.resource.data.name is string
          && request.resource.data.ingredients is list
          && request.resource.data.steps is list;
        allow update: if request.resource.data.name is string
          && request.resource.data.ingredients is list;
        allow delete: if true;
      }

      match /templates/{templateId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasAll(['name', 'sections', 'createdAt'])
          && request.resource.data.name is string
          && request.resource.data.sections is list;
        allow update: if request.resource.data.name is string
          && request.resource.data.sections is list;
        allow delete: if true;
      }

      match /ingredientCategories/{categoryId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasAll(['name', 'order', 'createdAt'])
          && request.resource.data.name is string
          && request.resource.data.order is int;
        allow update: if request.resource.data.name is string;
        allow delete: if true;
      }
    }

    // Per-user pull-up / exercise tracking
    match /users/{userId}/pullupSessions/{sessionId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['createdAt', 'assistanceBands', 'isMaxTest', 'targetReps', 'intervalSeconds', 'sets', 'totalReps'])
        && request.resource.data.assistanceBands is int
        && request.resource.data.assistanceBands >= 0
        && request.resource.data.assistanceBands <= 3
        && request.resource.data.isMaxTest is bool
        && request.resource.data.sets is list
        && request.resource.data.totalReps is int;
      allow update: if false;
    }

    // Per-user decking layout tool
    match /users/{userId}/decks/{deckId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['name', 'width', 'sideA', 'sideB', 'joistSpacing', 'boardWidth', 'boardGap', 'stock', 'minStaggerJoists', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.width is number
        && request.resource.data.sideA is number
        && request.resource.data.sideB is number
        && request.resource.data.stock is list
        // points is optional (its absence means the classic trapezoid
        // shape) — once present, at least a list of 3+ corners
        && (!('points' in request.resource.data) || (request.resource.data.points is list && request.resource.data.points.size() >= 3))
        // projectId is optional — absent means this deck isn't pooled
        // with a project's shared stock (see DeckConfig.projectId)
        && (!('projectId' in request.resource.data) || request.resource.data.projectId is string);
    }

    // Decking: public decks. No owner at all — anyone can view, create, or
    // edit one (shuffle, join edits, mark boards cut), no login required.
    // Same schema check as the private decks above; update is allowed (a
    // deck is a living document, not a save-once record like the retaining
    // wall designs) but delete never is, so a public deck can't be
    // vandalised away entirely by a random visitor, only edited.
    match /publicDecks/{deckId} {
      allow get, list: if true;
      allow create, update: if request.resource.data.keys().hasAll(['name', 'width', 'sideA', 'sideB', 'joistSpacing', 'boardWidth', 'boardGap', 'stock', 'minStaggerJoists', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.width is number
        && request.resource.data.sideA is number
        && request.resource.data.sideB is number
        && request.resource.data.stock is list
        && (!('points' in request.resource.data) || (request.resource.data.points is list && request.resource.data.points.size() >= 3))
        && (!('projectId' in request.resource.data) || request.resource.data.projectId is string);
      allow delete: if false;
    }

    // Decking: shared board stockpiles a project's decks can draw from —
    // see DeckProject's own doc comment. Same private/public split and
    // schema-check shape as decks above (a project's location works
    // identically to a deck's); doesn't reference member decks at all,
    // that link only ever lives on the deck side (projectId/projectOrder).
    match /users/{userId}/projects/{projectId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['name', 'stock', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.stock is list;
    }

    match /publicProjects/{projectId} {
      allow get, list: if true;
      allow create, update: if request.resource.data.keys().hasAll(['name', 'stock', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.stock is list;
      allow delete: if false;
    }

    // Retaining wall calculator: saved custom calc-settings presets.
    // Public for now (no auth) — anyone can create a named preset or list/
    // read every saved one; update/delete are off entirely, so a save is a
    // new immutable entry rather than something overwritable in place.
    match /retainingWallCalcSettings/{id} {
      allow get, list: if true;
      allow create: if request.resource.data.keys().hasAll(['name', 'settings', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.settings is map;
      allow update, delete: if false;
    }

    // Retaining wall calculator: saved wall designs. Same public-for-now,
    // create-only shape as the presets above. Each design embeds a full
    // CalcSettings snapshot rather than referencing a preset by id, so it
    // always reproduces the exact result it had when saved even if the
    // preset it started from is later changed.
    match /retainingWallDesigns/{id} {
      allow get, list: if true;
      allow create: if request.resource.data.keys().hasAll(
          ['name', 'wallLengthM', 'retainedHeightM', 'soil', 'rlDatumM', 'controlPoints', 'cornerPosts', 'topCapEnabled', 'calcSettings', 'createdAt']
        )
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.wallLengthM is number
        && request.resource.data.retainedHeightM is number
        && request.resource.data.soil is string
        && request.resource.data.calcSettings is map;
      allow update, delete: if false;
    }

    // Default: deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
