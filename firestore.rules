rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ContactUs collection - only server-side writes via API route
    // Client-side access is restricted for security
    match /ContactUs/{document} {
      // Deny all client-side reads and writes
      // Only server-side (admin SDK) can access this collection
      allow read: if false;
      allow write: if false;
    }
    
    // Allow authenticated admin users to read ContactUs (optional)
    // Uncomment and adjust if you want admin dashboard access
    // match /ContactUs/{document} {
    //   allow read: if request.auth != null && 
    //                  request.auth.token.admin == true;
    //   allow write: if false;
    // }
    
    // Dice Roll Tracker sessions
    match /diceSessions/{sessionId} {
      allow get: if true;
      allow list: if request.auth != null && request.auth.token.admin == true;
      allow create: if request.resource.data.keys().hasAll(['createdAt', 'creatorName', 'players', 'customRules'])
        && request.resource.data.creatorName is string
        && request.resource.data.players is list
        && request.resource.data.customRules is list;
      allow update: if request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.creatorName == resource.data.creatorName;
      allow delete: if false;

      match /rolls/{rollId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasAll(['player', 'dice', 'diceTypes', 'total', 'isRandom', 'game', 'timestamp'])
          && request.resource.data.dice is list
          && request.resource.data.dice.size() >= 1
          && request.resource.data.dice.size() <= 6
          && request.resource.data.diceTypes is list
          && request.resource.data.total is int
          && request.resource.data.game is int;
        allow update: if false;
        allow delete: if true;
      }
    }

    // Menu sessions
    match /menuSessions/{sessionId} {
      allow get: if true;
      allow list: if false;
      allow create: if request.resource.data.keys().hasAll(['createdAt', 'creatorName'])
        && request.resource.data.creatorName is string;
      allow update: if true;
      allow delete: if false;

      match /pantry/{itemId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasAll(['name', 'quantity', 'updatedAt'])
          && request.resource.data.name is string;
        allow update: if true;
        allow delete: if true;
      }

      match /consumptionLog/{logId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasAll(['mealId', 'mealName', 'date'])
          && request.resource.data.mealName is string;
        allow update: if false;
        allow delete: if true;
      }

      match /meals/{mealId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasAll(['name', 'ingredients', 'steps', 'createdAt'])
          && request.resource.data.name is string
          && request.resource.data.ingredients is list
          && request.resource.data.steps is list;
        allow update: if request.resource.data.name is string
          && request.resource.data.ingredients is list;
        allow delete: if true;
      }

      match /templates/{templateId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasAll(['name', 'sections', 'createdAt'])
          && request.resource.data.name is string
          && request.resource.data.sections is list;
        allow update: if request.resource.data.name is string
          && request.resource.data.sections is list;
        allow delete: if true;
      }

      match /ingredientCategories/{categoryId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasAll(['name', 'order', 'createdAt'])
          && request.resource.data.name is string
          && request.resource.data.order is int;
        allow update: if request.resource.data.name is string;
        allow delete: if true;
      }

      // Step-by-step recipes for Cook mode
      match /recipes/{recipeId} {
        allow read: if true;
        allow create, update: if request.resource.data.name is string
          && request.resource.data.ingredients is list
          && request.resource.data.steps is list;
        allow delete: if true;
      }

      // Live cook state, one doc per recipe (ticks, current step, timers, batches)
      match /cooks/{recipeId} {
        allow read: if true;
        allow create, update: if request.resource.data.recipeId == recipeId
          && request.resource.data.batches is list
          && request.resource.data.timers is map;
        allow delete: if true;
      }

      // Finished cooks with per-batch times
      match /cookLogs/{logId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasAll(['recipeId', 'recipeName', 'startedAt', 'finishedAt', 'batches'])
          && request.resource.data.recipeName is string
          && request.resource.data.batches is list;
        allow update: if false;
        allow delete: if true;
      }
    }

    // Per-user pull-up / exercise tracking
    match /users/{userId}/pullupSessions/{sessionId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['createdAt', 'assistanceBands', 'isMaxTest', 'targetReps', 'intervalSeconds', 'sets', 'totalReps'])
        && request.resource.data.assistanceBands is int
        && request.resource.data.assistanceBands >= 0
        && request.resource.data.assistanceBands <= 3
        && request.resource.data.isMaxTest is bool
        && request.resource.data.sets is list
        && request.resource.data.totalReps is int;
      allow update: if false;
    }

    // Per-user interview prep progress: one doc ("progress") holding a
    // lesson id -> done map and a module id -> confidence (1-5) map.
    match /users/{userId}/interviewPrep/{docId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && docId == 'progress'
        && request.resource.data.keys().hasOnly(['done', 'confidence', 'updatedAt'])
        && (!('done' in request.resource.data) || request.resource.data.done is map)
        && (!('confidence' in request.resource.data) || request.resource.data.confidence is map);
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Per-user decking layout tool
    match /users/{userId}/decks/{deckId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['name', 'width', 'sideA', 'sideB', 'joistSpacing', 'boardWidth', 'boardGap', 'stock', 'minStaggerJoists', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.width is number
        && request.resource.data.sideA is number
        && request.resource.data.sideB is number
        && request.resource.data.stock is list
        // points is optional (its absence means the classic trapezoid
        // shape) — once present, at least a list of 3+ corners
        && (!('points' in request.resource.data) || (request.resource.data.points is list && request.resource.data.points.size() >= 3))
        // projectId is optional — absent means this deck isn't pooled
        // with a project's shared stock (see DeckConfig.projectId)
        && (!('projectId' in request.resource.data) || request.resource.data.projectId is string);
    }

    // Decking: public decks. No owner at all — anyone can view, create, or
    // edit one (shuffle, join edits, mark boards cut), no login required.
    // Same schema check as the private decks above; update is allowed (a
    // deck is a living document, not a save-once record like the retaining
    // wall designs) but delete never is, so a public deck can't be
    // vandalised away entirely by a random visitor, only edited.
    match /publicDecks/{deckId} {
      allow get, list: if true;
      allow create, update: if request.resource.data.keys().hasAll(['name', 'width', 'sideA', 'sideB', 'joistSpacing', 'boardWidth', 'boardGap', 'stock', 'minStaggerJoists', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.width is number
        && request.resource.data.sideA is number
        && request.resource.data.sideB is number
        && request.resource.data.stock is list
        && (!('points' in request.resource.data) || (request.resource.data.points is list && request.resource.data.points.size() >= 3))
        && (!('projectId' in request.resource.data) || request.resource.data.projectId is string);
      allow delete: if false;
    }

    // Decking: shared board stockpiles a project's decks can draw from —
    // see DeckProject's own doc comment. Same private/public split and
    // schema-check shape as decks above (a project's location works
    // identically to a deck's); doesn't reference member decks at all,
    // that link only ever lives on the deck side (projectId/projectOrder).
    // House calculator: the joinery defaults every house starts from (types,
    // their sizes and what they're measured from, the head height). Shared:
    // anyone reads them, anyone logged in changes them — one document.
    match /houseDefaults/{docId} {
      allow get: if true;
      allow create, update: if request.auth != null
        && docId == 'joinery'
        && request.resource.data.keys().hasOnly(['types', 'headMm', 'updatedAt', 'updatedBy'])
        && request.resource.data.types is list
        && request.resource.data.types.size() > 0
        && request.resource.data.types.size() <= 100
        && request.resource.data.headMm is number
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    match /users/{userId}/projects/{projectId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['name', 'stock', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.stock is list;
    }

    match /publicProjects/{projectId} {
      allow get, list: if true;
      allow create, update: if request.resource.data.keys().hasAll(['name', 'stock', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.stock is list;
      allow delete: if false;
    }

    // Retaining wall calculator: saved custom calc-settings presets.
    // Public for now (no auth) — anyone can create a named preset or list/
    // read every saved one; update/delete are off entirely, so a save is a
    // new immutable entry rather than something overwritable in place.
    match /retainingWallCalcSettings/{id} {
      allow get, list: if true;
      allow create: if request.resource.data.keys().hasAll(['name', 'settings', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.settings is map;
      allow update, delete: if false;
    }

    // Retaining wall calculator: saved wall designs. Same public-for-now,
    // create-only shape as the presets above. Each design embeds a full
    // CalcSettings snapshot rather than referencing a preset by id, so it
    // always reproduces the exact result it had when saved even if the
    // preset it started from is later changed.
    match /retainingWallDesigns/{id} {
      allow get, list: if true;
      allow create: if request.resource.data.keys().hasAll(
          ['name', 'wallLengthM', 'retainedHeightM', 'soil', 'rlDatumM', 'controlPoints', 'cornerPosts', 'topCapEnabled', 'calcSettings', 'createdAt']
        )
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.wallLengthM is number
        && request.resource.data.retainedHeightM is number
        && request.resource.data.soil is string
        && request.resource.data.calcSettings is map;
      allow update, delete: if false;
    }

    // Decking: "ordered X, this length mix turned up" observations —
    // feeds the pack-mix prediction "Calculate quantity order" uses.
    // Same public/create-only shape as the retaining-wall records above
    // (an immutable snapshot, not a living document), plus delete — a
    // wrongly-entered data point actively skews every future prediction,
    // so it needs to be removable, unlike a saved design.
    match /stockOrders/{id} {
      allow get, list, delete: if true;
      allow create: if request.resource.data.keys().hasAll(['label', 'orderedAt', 'stock', 'createdAt'])
        && request.resource.data.label is string
        && request.resource.data.stock is list
        // orderedLinealMm is optional — absent means it wasn't recorded,
        // not that nothing was ordered
        && (!('orderedLinealMm' in request.resource.data) || request.resource.data.orderedLinealMm is number);
      allow update: if false;
    }

    // Weatherboard calculator projects. Same private/public split as the
    // decking decks/projects above: private ones live under the owner's
    // account; public ones have no owner — anyone can view, create, or
    // edit one with no login, but never delete, so a public project can be
    // edited by a random visitor but not wiped out. `summary` is the brief
    // order the projects page shows on each card.
    match /users/{userId}/weatherboardProjects/{projectId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name', 'settings', 'elevations', 'plan', 'summary', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.settings is map
        && request.resource.data.elevations is list
        && (!('plan' in request.resource.data) || request.resource.data.plan is map)
        && request.resource.data.summary is map
        && request.resource.data.updatedAt is timestamp;
    }

    match /publicWeatherboardProjects/{projectId} {
      allow get, list: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['name', 'settings', 'elevations', 'plan', 'summary', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.settings is map
        && request.resource.data.elevations is list
        && (!('plan' in request.resource.data) || request.resource.data.plan is map)
        && request.resource.data.summary is map
        && request.resource.data.updatedAt is timestamp;
      allow delete: if false;
    }

    // Retaining wall calculator projects. Same private/public split as the
    // weatherboard projects above: private ones live under the owner's
    // account; public ones have no owner — anyone can view, create, or
    // edit one with no login, but only an admin can delete one. An admin
    // can also list and delete every account's private projects (the
    // collection-group rule below), to clear out duplicates. `wall` is the whole wall
    // (plan, inputs, hand-set levels, calc settings snapshot); `summary`
    // is the brief figures the projects page shows on each card.
    match /users/{userId}/retainingWallProjects/{projectId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name', 'wall', 'summary', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.wall is map
        && request.resource.data.summary is map
        && request.resource.data.updatedAt is timestamp;
      // an admin can change anyone's (see projectOwner.ts)
      allow update: if request.auth != null && request.auth.token.admin == true
        && request.resource.data.keys().hasOnly(['name', 'wall', 'summary', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.wall is map
        && request.resource.data.summary is map
        && request.resource.data.updatedAt is timestamp;
    }

    match /publicRetainingWallProjects/{projectId} {
      allow get, list: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['name', 'wall', 'summary', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.wall is map
        && request.resource.data.summary is map
        && request.resource.data.updatedAt is timestamp;
      allow delete: if request.auth != null && request.auth.token.admin == true;
    }

    // Site projects: output from several calculators on one site (a
    // retaining wall with stairs on it, to start with). Same private /
    // public split as retaining wall projects. `site` is the whole
    // project; `summary` is what the projects list shows.
    match /users/{userId}/siteProjects/{projectId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name', 'site', 'summary', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.site is map
        && request.resource.data.summary is map
        && request.resource.data.updatedAt is timestamp;
      // an admin can change anyone's (see projectOwner.ts)
      allow update: if request.auth != null && request.auth.token.admin == true
        && request.resource.data.keys().hasOnly(['name', 'site', 'summary', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.site is map
        && request.resource.data.summary is map
        && request.resource.data.updatedAt is timestamp;
    }

    match /publicSiteProjects/{projectId} {
      allow get, list: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['name', 'site', 'summary', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.site is map
        && request.resource.data.summary is map
        && request.resource.data.updatedAt is timestamp;
      allow delete: if request.auth != null && request.auth.token.admin == true;
    }

    // Saved stairs: the stairs calculator's inputs. Same private / public
    // split as retaining wall projects. `stair` is the whole stair;
    // `summary` is what the stairs list shows.
    match /users/{userId}/stairProjects/{projectId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name', 'stair', 'summary', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.stair is map
        && request.resource.data.summary is map
        && request.resource.data.updatedAt is timestamp;
      // an admin can change anyone's (see projectOwner.ts)
      allow update: if request.auth != null && request.auth.token.admin == true
        && request.resource.data.keys().hasOnly(['name', 'stair', 'summary', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.stair is map
        && request.resource.data.summary is map
        && request.resource.data.updatedAt is timestamp;
    }

    match /publicStairProjects/{projectId} {
      allow get, list: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['name', 'stair', 'summary', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.stair is map
        && request.resource.data.summary is map
        && request.resource.data.updatedAt is timestamp;
      allow delete: if request.auth != null && request.auth.token.admin == true;
    }

    // Saved floors: the floor framing calculator's inputs. Same private /
    // public split as stairs. `floor` is the whole floor; `summary` is what
    // the floors list shows.
    match /users/{userId}/floorProjects/{projectId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name', 'floor', 'summary', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.floor is map
        && request.resource.data.summary is map
        && request.resource.data.updatedAt is timestamp;
      // an admin can change anyone's (see projectOwner.ts)
      allow update: if request.auth != null && request.auth.token.admin == true
        && request.resource.data.keys().hasOnly(['name', 'floor', 'summary', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.floor is map
        && request.resource.data.summary is map
        && request.resource.data.updatedAt is timestamp;
    }

    match /publicFloorProjects/{projectId} {
      allow get, list: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['name', 'floor', 'summary', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.floor is map
        && request.resource.data.summary is map
        && request.resource.data.updatedAt is timestamp;
      allow delete: if request.auth != null && request.auth.token.admin == true;
    }

    // House calculator projects: the same private/public split as floors.
    // `house` is the whole house (plan, settings, the link to its cladding);
    // `summary` is the brief figures the houses page shows on each card.
    match /users/{userId}/houseProjects/{projectId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name', 'house', 'summary', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.house is map
        && request.resource.data.summary is map
        && request.resource.data.updatedAt is timestamp;
      // an admin can change anyone's (see projectOwner.ts)
      allow update: if request.auth != null && request.auth.token.admin == true
        && request.resource.data.keys().hasOnly(['name', 'house', 'summary', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.house is map
        && request.resource.data.summary is map
        && request.resource.data.updatedAt is timestamp;
    }

    match /publicHouseProjects/{projectId} {
      allow get, list: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['name', 'house', 'summary', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.house is map
        && request.resource.data.summary is map
        && request.resource.data.updatedAt is timestamp;
      allow delete: if request.auth != null && request.auth.token.admin == true;
    }

    match /{path=**}/houseProjects/{projectId} {
      allow read, delete: if request.auth != null && request.auth.token.admin == true;
    }

    match /{path=**}/retainingWallProjects/{projectId} {
      allow read, delete: if request.auth != null && request.auth.token.admin == true;
    }

    // an admin can list, open and delete every account's site projects and
    // stairs too, as with retaining walls
    match /{path=**}/siteProjects/{projectId} {
      allow read, delete: if request.auth != null && request.auth.token.admin == true;
    }

    match /{path=**}/stairProjects/{projectId} {
      allow read, delete: if request.auth != null && request.auth.token.admin == true;
    }

    match /{path=**}/floorProjects/{projectId} {
      allow read, delete: if request.auth != null && request.auth.token.admin == true;
    }

    // Retaining wall activity log: one entry per finished change, undo,
    // redo, lock or unlock on any wall (see wallActivity.ts). Anyone
    // editing a wall can add one — the calculator works signed out — but
    // an entry can't claim to be someone else (the actor is whoever's
    // signed in, or nobody), can't backdate itself, and can never be
    // changed or deleted. Only an admin can read the log.
    match /retainingWallActivity/{id} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow create: if request.resource.data.keys().hasOnly(
          ['projectKind', 'projectId', 'projectName', 'ownerUid', 'action', 'label', 'fields', 'actorUid', 'actorEmail', 'at']
        )
        && request.resource.data.keys().hasAll(
          ['projectKind', 'projectId', 'projectName', 'ownerUid', 'action', 'label', 'fields', 'actorUid', 'actorEmail', 'at']
        )
        && request.resource.data.projectKind in ['public', 'private', 'scratch']
        && request.resource.data.projectId is string
        && request.resource.data.projectId.size() > 0
        && request.resource.data.projectId.size() <= 128
        && request.resource.data.projectName is string
        && request.resource.data.projectName.size() <= 100
        // a private project is only ever edited by its owner
        && (request.resource.data.projectKind == 'private'
          ? (request.auth != null && request.resource.data.ownerUid == request.auth.uid)
          : request.resource.data.ownerUid == null)
        && request.resource.data.action in ['change', 'undo', 'redo', 'lock', 'unlock']
        && request.resource.data.label is string
        && request.resource.data.label.size() <= 300
        && request.resource.data.fields is list
        && request.resource.data.fields.size() <= 40
        && request.resource.data.at == request.time
        && (
          (request.auth == null
            && request.resource.data.actorUid == null
            && request.resource.data.actorEmail == null)
          || (request.auth != null
            && request.resource.data.actorUid == request.auth.uid
            && request.resource.data.actorEmail == request.auth.token.get('email', null))
        );
      allow update, delete: if false;
    }

    // Default: deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
